{% include "snippets/http_connection_map.conf.j2" %}

{% macro location_block(location) %}
location {{ location.path }} {
    {% if location.type == "reverse_proxy" %}
        {% include "snippets/generic_reverse_proxy.conf.j2" %}
        proxy_pass {{ location.target }};
    {% elif location.type == "static" %}
        root {{ location.webroot }};
        index index.html;
    {% endif %}
}
{% endmacro %}

server {
    listen 80;
    listen [::]:80;

    {% include "snippets/server_name.conf.j2" %}
    {% if site.https_redirect_to_primary_domain %}
        {%- include "snippets/https_redirect_primary_domain.conf.j2" %}
    {% else %}
        {%- include "snippets/https_redirect.conf.j2" %}
    {%- endif %}
    {% include "snippets/certbot_webroot.conf.j2" %}

    {% if not site.https_enable %}
        {% for location in site.locations %}
            {{ location_block(location) }}
        {% endfor %}
    {% endif %}
}

{% if site.https_enable %}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    {% include "snippets/server_name.conf.j2" %}
    {% with certs = acme_certs_dir(site.domain, site.domain_aliases) %}
        ssl_certificate {{ certs.certificate_pem }};
        ssl_trusted_certificate {{ certs.trusted_certificate_pem }};
        ssl_certificate_key {{ certs.certificate_key_pem }};
    {%- endwith %}

    {% for location in site.locations %}
        {{ location_block(location) }}
    {% endfor %}
}
{% endif %}
